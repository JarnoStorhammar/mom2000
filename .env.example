# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_HOST=mqtt
MQTT_PORT=1883

# ── Camera ────────────────────────────────────────────────────────────────────
# "webcam" or "rtsp"
CAMERA_SOURCE=webcam
WEBCAM_DEVICE=0
# Used only when CAMERA_SOURCE=rtsp
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1

# ── Face recognition ──────────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.55
FACE_DETECTION_INTERVAL=3.0
EMBEDDINGS_PATH=/app/embeddings

# ── Dish monitoring (ROI as x1,y1,x2,y2 fractions of frame size) ─────────────
DISH_ROI=0.1,0.2,0.9,0.8
DISH_TIMEOUT_MINUTES=15
DISH_COOLDOWN_MINUTES=30
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# ── Voice / STT ───────────────────────────────────────────────────────────────
# "always" or "push_to_talk"
LISTEN_MODE=always
WHISPER_MODEL=small

# ── TTS / Audio ───────────────────────────────────────────────────────────────
PIPER_BIN=/usr/local/bin/piper
PIPER_VOICE=fi_FI-harri-medium
PIPER_MODELS_DIR=/app/models/piper
# Run: pactl list sinks short  → copy sink name here
AUDIO_OUTPUT_SINK=bluez_sink.XX_XX_XX_XX_XX_XX.a2dp_sink

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
